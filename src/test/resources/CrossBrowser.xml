<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="QaseIO CrossBrowser Test" thread-count="2" parallel="tests">
    <listeners>
        <listener class-name="tests.base.AnnotationTransformer"></listener>
        <listener class-name="tests.base.TestListener"></listener>
    </listeners>
    <test name="Chrome">
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.CreateCaseTest"/>
            <class name="tests.CaseDetailsTest"/>
            <parameter name="browser" value="chrome"></parameter>
        </classes>
    </test> <!-- Test -->
    <test name="Firefox">
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.CreateCaseTest"/>
            <class name="tests.CaseDetailsTest"/>
            <parameter name="browser" value="firefox"></parameter>
        </classes>
    </test> <!-- Test -->
</suite>
